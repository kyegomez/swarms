# Framework configuration

# Directory for agent state, autosaves and logs.
WORKSPACE_DIR="agent_workspace"

# Verbose mode. Console tracebacks then include local variables, which can hold keys.
SWARMS_VERBOSE_GLOBAL="False"

# Write log files to WORKSPACE_DIR/logs. False by default (console only).
SWARMS_LOG_FILES="False"

# Telemetry is ON by default. Set to false/0/no/off to opt out.
SWARMS_TELEMETRY_ON="true"

# Library for model calls: "routehub" (installed by swarms[fast]) or "litellm". Empty uses RouteHub when installed.
SWARMS_LLM_BACKEND=""

# Warn when an agent is built with an unknown model or a max_tokens above the model's limit.
SWARMS_STRICT_MODEL_CHECK="False"

# Swarms marketplace (swarms.world). Only needed to publish or load marketplace prompts and agents.
SWARMS_API_KEY=""


# Model provider keys

OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""
PPLX_API_KEY=""
AI21_API_KEY=""
HUGGINGFACE_TOKEN=""


# Comms channels

# SmtpChannel (email over SMTP and IMAP). The username defaults to from_address; for Gmail use an app password.
SMTP_USERNAME=""
SMTP_PASSWORD=""

# AgentMailChannel (an email thread in an AgentMail inbox).
AGENTMAIL_API_KEY=""

# AgentMailChannel(backend="resend"): a full-access Resend key.
RESEND_API_KEY=""


# Cloud providers

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_DEPLOYMENT=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_AD_TOKEN=""
OPENAI_API_VERSION=""
