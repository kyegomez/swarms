# Framework configuration

WORKSPACE_DIR="agent_workspace"    # Directory for agent state, autosaves and logs.
SWARMS_VERBOSE_GLOBAL="False"      # Verbose mode. Console tracebacks then include local variables, which can hold keys.
SWARMS_LOG_FILES="False"           # Write log files to WORKSPACE_DIR/logs. False by default (console only).
SWARMS_GLOBAL_LOGGER_ON="True"     # Master switch for Swarms logging. False turns every Swarms log off: no console output and no log files.
SWARMS_TELEMETRY_ON="true"         # Telemetry is ON by default. Set to false/0/no/off to opt out.
SWARMS_LLM_BACKEND=""              # Library for model calls: "routehub" (installed by swarms[fast]) or "litellm". Empty uses RouteHub when installed.
SWARMS_STRICT_MODEL_CHECK="False"  # Warn when an agent is built with an unknown model or a max_tokens above the model's limit.
SWARMS_API_KEY=""                  # Swarms marketplace (swarms.world). Only needed to publish or load marketplace prompts and agents.


# Model provider keys

OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""
PPLX_API_KEY=""
AI21_API_KEY=""
HUGGINGFACE_TOKEN=""


# Comms channels

SMTP_USERNAME=""                   # SmtpChannel (email over SMTP and IMAP). Defaults to from_address.
SMTP_PASSWORD=""                   # SmtpChannel password. For Gmail use an app password.
AGENTMAIL_API_KEY=""               # AgentMailChannel (an email thread in an AgentMail inbox).
RESEND_API_KEY=""                  # AgentMailChannel(backend="resend"): a full-access Resend key.


# Cloud providers

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_DEPLOYMENT=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_AD_TOKEN=""
OPENAI_API_VERSION=""
