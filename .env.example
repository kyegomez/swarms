# Framework Configuration
WORKSPACE_DIR="agent_workspace"
SWARMS_VERBOSE_GLOBAL="False"
SWARMS_API_KEY=""
# Telemetry is ON by default. Set to false/0/no/off to opt out.
SWARMS_TELEMETRY_ON="true"
# Library for model calls: "routehub" (installed by swarms[fast]) or "litellm". Empty uses RouteHub when installed.
SWARMS_LLM_BACKEND=""
# Write log files to WORKSPACE_DIR/logs. False by default (console only).
SWARMS_LOG_FILES="False"
SWARMS_STRICT_MODEL_CHECK="False"




